# Automatic HTTPS. Caddy obtains and renews certificates with ACME.
# Set PUBLIC_DOMAIN and ACME_EMAIL in .env before starting.

{
    email {$ACME_EMAIL}
    # HSTS at the edge; the backend also sets it for API responses.
    servers {
        protocols h1 h2 h3
    }
}

{$PUBLIC_DOMAIN} {
    encode zstd gzip

    # Security headers applied to every response.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # API goes to FastAPI.
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Everything else is the Next.js app.
    handle {
        reverse_proxy frontend:3000
    }

    log {
        output file /data/access.log {
            roll_size 10MiB
            roll_keep 5
        }
        format json
    }
}
