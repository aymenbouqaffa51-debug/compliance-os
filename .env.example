# Copy to .env and fill in. Never commit .env.

# --- required secrets -------------------------------------------------------
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
COMPLIANCE_JWT_SECRET=

# Generate with:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This key encrypts stored integration credentials. Losing it means those
# credentials must be re-entered; leaking it means they must be rotated.
COMPLIANCE_SECRET_KEY=

POSTGRES_PASSWORD=

# --- domain and TLS ---------------------------------------------------------
PUBLIC_DOMAIN=compliance.example.com
ACME_EMAIL=you@example.com
PUBLIC_ORIGIN=https://compliance.example.com

# --- database ---------------------------------------------------------------
POSTGRES_USER=compliance
POSTGRES_DB=compliance

# --- optional collectors (only needed for automated monitoring) -------------
# Perimeter checks need no credentials at all.
# GITHUB_ORG=
# GITHUB_TOKEN=
# AWS_REGION=eu-west-3
# WORKSPACE_DOMAIN=
